# Executable mirror of the configuration reference in the README.
# Copy to .env and edit. Every value shown is the built-in default.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=8080
# Loopback by default, so a stray `docker run` doesn't publish to your LAN.
# The Docker image sets 0.0.0.0 because published ports need it; the compose
# file binds 127.0.0.1 on the host side instead.
HOST=127.0.0.1
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------
# KEEP THIS ON LOCAL DISK. SQLite's locking depends on POSIX advisory locks,
# which are unreliable or silently broken over NFS and CIFS. The documented
# failure mode is `database disk image is malformed` — corruption, not a clean
# error. It's only tens of MB, so there's no storage argument for moving it.
# Back it up by exporting, not by relocating it.
DATABASE_PATH=./data/vault.db

# Staging: raw archives exactly as served. Disposable, can be a scratch disk.
DOWNLOADS_PATH=./downloads

# The organized output — what you point emulators at, and what you back up.
LIBRARY_PATH=./library

# Extract/convert scratch. Defaults to {LIBRARY_PATH}/.tmp so the final move is
# an instant rename rather than a copy. On a slow NAS link, pointing this at
# local disk can be faster overall; the trade-off is that the final move then
# becomes a cross-device copy. The startup preflight tells you which you get.
WORK_PATH=

# Built React client. Empty in dev, where Vite serves it and proxies /api.
WEB_ROOT=

# ---------------------------------------------------------------------------
# Crawler politeness
# ---------------------------------------------------------------------------
# One request per this many ms, single concurrency. A full PS2 sync is ~75
# requests — about 7 minutes, once a month.
CRAWL_DELAY_MS=1200
# Honest and self-identifying. Used for ALL crawling. (The download endpoint is
# separate — see DOWNLOAD_USER_AGENT.)
USER_AGENT=vl-collection-builder/0.1 (personal catalogue tool)
REQUEST_TIMEOUT_MS=30000
CRAWL_MAX_RETRIES=3

# Consecutive failures before the source is skipped entirely, so a site that is
# down produces one clear error instead of hundreds of timeouts.
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_RESET_MS=300000

# ---------------------------------------------------------------------------
# Source registry
# ---------------------------------------------------------------------------
# Both optional. Order is SOURCES_PATH -> SOURCES_URL -> embedded defaults.
# A malformed override warns and falls back rather than blocking boot, so a typo
# in a mounted file can't take the container down.
SOURCES_PATH=
SOURCES_URL=

# ---------------------------------------------------------------------------
# First-run setup
# ---------------------------------------------------------------------------
# Pre-fills the wizard's region step. Empty means the wizard asks and will not
# proceed until you choose — there is deliberately no silent USA default.
REGION_PREFERENCE=
# true AND a non-empty REGION_PREFERENCE completes setup unattended. On its own
# it does nothing, because guessing the region is the failure being prevented.
SETUP_SKIP=false

# ---------------------------------------------------------------------------
# Downloads
# ---------------------------------------------------------------------------
# NOTE THE ABSENCE OF A CONCURRENCY SETTING. Vimm's operator has stated
# downloads are one at a time, and vl-downloader's author asks the same. The
# worker is a single loop by construction, not a pool sized to 1. See "Why
# downloads are serial" in the README.
DOWNLOADS_ENABLED=true
# Deliberate pause between files.
INTER_DOWNLOAD_DELAY_MS=3000
DOWNLOAD_RETRY_LIMIT=3
# 0 = no timeout. ROMs are large and links can be slow.
DOWNLOAD_TIMEOUT_MS=0
# Headroom required before starting a file.
MIN_FREE_DISK_MB=2048
# The download host rejects our honest crawler UA with 400, even with a full set
# of standard headers — the UA itself is the trigger. Empty uses a built-in
# browser UA for this endpoint only; crawling keeps the honest one.
DOWNLOAD_USER_AGENT=

# ---------------------------------------------------------------------------
# Organizing
# ---------------------------------------------------------------------------
# False reduces the tool to a plain downloader; files stop at staging.
ORGANIZE_ENABLED=true

# disc-only | always | never
# Cartridge ROMs are read from zip natively by RetroArch and most emulators, so
# a zipped SNES library is far smaller and works identically. Disc images must
# be extracted — no emulator mounts a 4 GB ISO from inside a zip.
EXTRACT_POLICY=disc-only

# true keeps staging archives, which makes re-organizing free (no re-download).
KEEP_ARCHIVE=false

# Tokens: {title} {region} {version} {platform} {vaultId} {disc}
# Settings shows a live preview over three examples before you apply a change.
NAMING_TEMPLATE={title} ({region})

# slug | esde | batocera | retroarch
# Front-ends auto-detect systems by folder name and disagree with each other. A
# mismatch isn't a data error — the front-end just shows an empty system and the
# games look missing.
PLATFORM_FOLDER_STYLE=slug
# Per-platform overrides layered on top of the preset, e.g.
#   PLATFORM_FOLDER_MAP=genesis=megadrive,xbox=microsoft-xbox
# Unknown slugs are warned about in Settings and ignored.
PLATFORM_FOLDER_MAP=

# Playlists for multi-disc sets, so emulators can swap discs mid-game.
GENERATE_M3U=true
# Rewrites .cue/.gdi internal references after renaming. Without this, a renamed
# disc image points at a file that no longer exists: nothing errors, and the
# game simply won't boot.
REWRITE_CUE_PATHS=true

# disc-only | never
# chdman packs .bin/.cue and .iso into one compressed .chd, typically 40-60%
# smaller with no data loss. `chdman verify` runs before the source is deleted.
CHD_POLICY=disc-only
CHD_KEEP_SOURCE=false

# Extraction needs archive + extracted size available at once; disc images
# roughly double during the operation.
ORGANIZE_MIN_FREE_DISK_MB=4096

# ---------------------------------------------------------------------------
# Optional resolver — NOT IMPLEMENTED (phase 8 of the plan)
# ---------------------------------------------------------------------------
# Tier 3 is skipped, which is exactly the path taken when no key is configured,
# so nothing is stubbed. Run `npm run eval` before deciding it's worth a key.
RESOLVER=
GEMINI_API_KEY=
RESOLVER_MODEL=
# Hard cap on items sent per import, as a cost guard.
RESOLVER_MAX_ITEMS=50
