# Executable mirror of the configuration reference (plan §13.2).
# Copy to .env and edit. Every value here is the built-in default.

# --- server ---
PORT=8080
# Loopback by default. In Docker this is forced to 0.0.0.0 so published ports work.
HOST=127.0.0.1
LOG_LEVEL=info

# --- paths ---
# Keep this on local disk. SQLite's locking is unreliable over NFS/CIFS and the
# documented failure mode is silent corruption, not a clean error (plan §9.6b).
DATABASE_PATH=./data/vault.db
# Built React client. Empty in dev, where Vite serves the client and proxies /api.
WEB_ROOT=

# --- source registry (plan §1.1) ---
# Both optional. Resolution order is SOURCES_PATH -> SOURCES_URL -> embedded
# defaults; a bad override warns and falls back rather than blocking boot.
SOURCES_PATH=
SOURCES_URL=

# --- crawler politeness ---
# One request per this many ms, single concurrency. A full platform is ~27
# requests, so the default costs about 35 seconds once a month.
CRAWL_DELAY_MS=1200
# Honest self-identifying UA. A browser UA is documented as a last resort only.
USER_AGENT=vault-lookup/0.1 (personal catalogue tool)
REQUEST_TIMEOUT_MS=30000
CRAWL_MAX_RETRIES=3

# --- circuit breaker (plan §1.1) ---
# Consecutive failures before the source is skipped, and how long until retry.
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_RESET_MS=300000

# --- first-run setup (plan §6.0) ---
# Pre-fills the wizard's region step. Empty means the wizard asks and will not
# proceed until you choose — there is deliberately no silent USA default.
REGION_PREFERENCE=
# true AND a non-empty REGION_PREFERENCE completes setup unattended. On its own
# it does nothing, because guessing the region is the failure being prevented.
SETUP_SKIP=false

# --- optional resolver (phase 8) ---
# Absent key means tier 3 is skipped entirely; more items reach the review queue
# and nothing else changes.
RESOLVER=
GEMINI_API_KEY=
RESOLVER_MODEL=
# Hard cap on items sent per import, as a cost guard.
RESOLVER_MAX_ITEMS=50
